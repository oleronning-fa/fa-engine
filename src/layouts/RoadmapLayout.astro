---
import '@fontsource-variable/inter';
import '../styles/roadmap.css';
import { AREAS, EPIC_LABEL_COLORS, IDEA_OWNER_NAMES } from '../core/codesets';
import { getAllUsers, getEpicOptions } from '../modules/roadmap/view/queries';
import JiraPeoplePicker from '../components/JiraPeoplePicker.astro';

interface Props {
  /** Page title, shown in the browser tab and as the topbar breadcrumb. */
  title: string;
  /** Which sidebar item is active — matches the nav hrefs below. */
  active: 'foryou' | 'list' | 'backlog' | 'epics' | 'ideas' | 'log';
}
const { title, active } = Astro.props;

const NAV = [
  { key: 'foryou', href: '/for-you', label: 'For deg' },
  { key: 'list', href: '/', label: 'All items' },
  { key: 'backlog', href: '/backlog', label: 'Backlog' },
  { key: 'epics', href: '/epics', label: 'Epics' },
  { key: 'ideas', href: '/idea-bank', label: 'Idea bank' },
  { key: 'log', href: '/log', label: 'Logg' },
] as const;

const user = Astro.locals.user;

// Shared across all three create dialogs, fetched once per page.
const people = await getAllUsers();
const epicOptions = await getEpicOptions();
const ideaOwners = people.filter((p) => (IDEA_OWNER_NAMES as readonly string[]).includes(p.name));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Fa Engine</title>
  </head>
  <body>
    <div class="app">
      <nav class="sidebar" aria-label="Modules">
        <div class="brand">
          <div class="brand-mark">FA</div>
          <div>
            <div class="brand-name">Fa Engine</div>
            <div class="brand-sub">v1.0 · Roadmap</div>
          </div>
        </div>

        <div class="nav-group">
          {NAV.map((item) => (
            <a class={`nav-item${active === item.key ? ' active' : ''}`} href={item.href}>
              <span>{item.label}</span>
            </a>
          ))}
        </div>

        <div class="nav-group">
          <div class="nav-label">Coming later</div>
          <span class="nav-item disabled"><span>Feedback hub</span><span class="soon">v1.1</span></span>
          <span class="nav-item disabled"><span>Weekly agent</span><span class="soon">v1.2</span></span>
          <span class="nav-item disabled"><span>CRM</span><span class="soon">v2.0</span></span>
        </div>

        <div class="sidebar-foot">
          <div class="avatar">{user ? user.email.slice(0, 2).toUpperCase() : 'FA'}</div>
          <div>
            <div class="sidebar-foot-name">{user?.email ?? 'Local dev'}</div>
            <div class="sidebar-foot-role">Product team</div>
          </div>
        </div>
      </nav>

      <div class="main">
        <div class="topbar">
          <div class="crumb"><b>{title}</b></div>
          <div class="topbar-actions">
            <slot name="actions" />
            <button class="btn btn-create btn-create-epic" type="button" data-open-dialog="epicDialog">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              New Epic
            </button>
            <button class="btn btn-outline" type="button" data-open-dialog="ideaDialog">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              New Idea
            </button>
            <button class="btn btn-create btn-create-task" type="button" data-open-dialog="taskDialog">
              <svg width="15" height="15" viewBox="0 0 16 16" fill="none"><path d="M8 3v10M3 8h10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
              New Task
            </button>
          </div>
        </div>
        <slot name="toolbar" />
        <div class="content">
          <slot />
        </div>
      </div>
    </div>

    <!-- ================= NEW EPIC ================= -->
    <dialog class="modal" id="epicDialog">
      <form method="POST" action="/api/roadmap-items">
        <input type="hidden" name="kind" value="epic" />
        <div class="modal-head">
          <div class="kind" style="background:var(--grey-900)">E</div>
          <div>
            <h3>New Epic</h3>
            <p>A long-term workstream — roadmap-krav §2</p>
          </div>
          <button class="modal-close" type="button" data-close-dialog aria-label="Close">✕</button>
        </div>
        <div class="modal-body">
          <div class="field">
            <label for="epTitle">Title</label>
            <input type="text" id="epTitle" name="title" placeholder="e.g. Redpill to AWS" required />
          </div>
          <div class="field">
            <label for="epDesc">Description <span class="opt">(what, and why)</span></label>
            <textarea id="epDesc" name="description" placeholder="Short context for anyone landing here for the first time…"></textarea>
          </div>
          <div class="field">
            <label for="epAssignees">Team <span class="opt">— which team can work on it</span></label>
            <select id="epAssignees" name="assigneeIds" multiple>
              {people.map((p) => <option value={p.id}>{p.name}</option>)}
            </select>
          </div>
          <JiraPeoplePicker id="epJira" />
          <div class="field-row">
            <div class="field">
              <label for="epOwner">Owner <span class="opt">(optional — type a name)</span></label>
              <input type="text" id="epOwner" name="ownerName" placeholder="e.g. Ole Christian" />
            </div>
            <div class="field">
              <label for="epTarget">Estimated delivery <span class="opt">(optional — most epics have none)</span></label>
              <input type="date" id="epTarget" name="targetDate" />
            </div>
          </div>
          <div class="field">
            <label>Importance label <span class="opt">(optional)</span></label>
            <div class="color-picker">
              <label class="color-swatch-none" title="No label">
                <input type="radio" name="colorLabel" value="" checked />
                <span aria-hidden="true">✕</span>
              </label>
              {EPIC_LABEL_COLORS.map((c) => (
                <label class="color-swatch" style={`--swatch-color:${c.hex}`} title={c.id}>
                  <input type="radio" name="colorLabel" value={c.id} />
                </label>
              ))}
            </div>
          </div>
          <div class="field">
            <div class="help">That's it — area, status, comments and sources can be filled in later. New epics start as <b>Ikke påbegynt</b>.</div>
          </div>
        </div>
        <div class="modal-foot">
          <div class="modal-foot-spacer"></div>
          <button class="btn btn-ghost" type="button" data-close-dialog>Cancel</button>
          <button class="btn btn-primary" type="submit">Create Epic</button>
        </div>
      </form>
    </dialog>

    <!-- ================= NEW IDEA (New Epic's interface, minus Team — too early for an idea) ================= -->
    <dialog class="modal" id="ideaDialog">
      <form method="POST" action="/api/roadmap-items">
        <input type="hidden" name="kind" value="idea" />
        <div class="modal-head">
          <div class="kind" style="background:var(--grey-700)">I</div>
          <div>
            <h3>New Idea</h3>
            <p>Not in Jira, nothing promised — idebank §1</p>
          </div>
          <button class="modal-close" type="button" data-close-dialog aria-label="Close">✕</button>
        </div>
        <div class="modal-body">
          <div class="field">
            <label for="idTitle">Title</label>
            <input type="text" id="idTitle" name="title" placeholder="e.g. 💡 Add maps to articles" required />
          </div>
          <div class="field">
            <label for="idDesc">Description <span class="opt">(what, and why)</span></label>
            <textarea id="idDesc" name="description" placeholder="Short context for anyone landing here for the first time…"></textarea>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="idOwner">Owner</label>
              <select id="idOwner" name="ownerId" required>
                <option value="">Choose an owner…</option>
                {ideaOwners.map((p) => <option value={p.id}>{p.name}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="idTarget">Want to be released by <span class="opt">(optional)</span></label>
              <input type="date" id="idTarget" name="targetDate" />
            </div>
          </div>
          <div class="field">
            <label>Importance label <span class="opt">(optional)</span></label>
            <div class="color-picker">
              <label class="color-swatch-none" title="No label">
                <input type="radio" name="colorLabel" value="" checked />
                <span aria-hidden="true">✕</span>
              </label>
              {EPIC_LABEL_COLORS.map((c) => (
                <label class="color-swatch" style={`--swatch-color:${c.hex}`} title={c.id}>
                  <input type="radio" name="colorLabel" value={c.id} />
                </label>
              ))}
            </div>
          </div>
          <div class="field">
            <div class="help">That's it — area, team, status, comments and attachments can be filled in later. New ideas start as status <b>Idea</b>, in the idea bank.</div>
          </div>
        </div>
        <div class="modal-foot">
          <div class="modal-foot-spacer"></div>
          <button class="btn btn-ghost" type="button" data-close-dialog>Cancel</button>
          <button class="btn btn-primary" type="submit">Create Idea</button>
        </div>
      </form>
    </dialog>

    <!-- ================= NEW TASK ================= -->
    <dialog class="modal" id="taskDialog">
      <form method="POST" action="/api/roadmap-items">
        <input type="hidden" name="kind" value="task" />
        <div class="modal-head">
          <div class="kind" style="background:var(--blue-500)">T</div>
          <div>
            <h3>New Task</h3>
            <p>A concrete, shippable piece of work — feltkatalog §3</p>
          </div>
          <button class="modal-close" type="button" data-close-dialog aria-label="Close">✕</button>
        </div>
        <div class="modal-body">
          <div class="field-row">
            <div class="field">
              <label for="tkTitle">Title</label>
              <input type="text" id="tkTitle" name="title" placeholder="e.g. Fix pagination on Watchlist table" required />
            </div>
            <div class="field">
              <label for="tkType">Type</label>
              <select id="tkType" name="type">
                <option>Task</option><option>Bug</option><option>Research</option>
              </select>
            </div>
          </div>
          <div class="field">
            <label for="tkDesc">Description <span class="opt">(what, and why)</span></label>
            <textarea id="tkDesc" name="description" placeholder="Short context — what needs to happen and why it matters…"></textarea>
          </div>
          <div class="field">
            <label for="tkNotes">Notes <span class="opt">(long free text — not on Epic)</span></label>
            <textarea class="notes" id="tkNotes" name="notes" placeholder="Anything that doesn't fit above: pasted context, background, things to remember. No structure required."></textarea>
            <div class="help">Free text, written by a person. Never auto-filled — feltkatalog §4.</div>
          </div>

          <div class="section-divider"><span>Placement</span></div>
          <div class="field-row">
            <div class="field">
              <label for="tkArea">Area <span class="opt">(required)</span></label>
              <select id="tkArea" name="area" required>
                <option value="">Choose an area…</option>
                {AREAS.map((a) => <option value={a.id}>{a.label}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="tkParent">Parent Epic <span class="opt">(optional)</span></label>
              <select id="tkParent" name="parentId">
                <option value="">No parent</option>
                {epicOptions.map((e) => <option value={e.id}>{e.name}</option>)}
              </select>
            </div>
          </div>

          <div class="section-divider"><span>Ownership &amp; status</span></div>
          <div class="field-row">
            <div class="field">
              <label for="tkHmOwner">Owner <span class="opt">(Hegnar Media)</span></label>
              <select id="tkHmOwner" name="ownerId">
                <option value="">Not set</option>
                {people.map((p) => <option value={p.id}>{p.name}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="tkOwner">Coordinator <span class="opt">(Profico)</span></label>
              <select id="tkOwner" name="coordinatorId">
                <option value="">Not set</option>
                {people.map((p) => <option value={p.id}>{p.name}</option>)}
              </select>
            </div>
          </div>
          <div class="field">
            <label for="tkStatus">Status</label>
            <select id="tkStatus" name="status">
              <option>Idea</option><option>Under review</option><option>Prioritized</option>
              <option>In Jira</option><option>Delivered</option>
            </select>
          </div>
          <div class="field">
            <label for="tkAssignees">Assignees (Team)</label>
            <select id="tkAssignees" name="assigneeIds" multiple>
              {people.map((p) => <option value={p.id}>{p.name}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="tkNewPeople">New person? <span class="opt">(not in the list above — comma-separated, they'll be added)</span></label>
            <input type="text" id="tkNewPeople" name="newPeople" placeholder="e.g. Kari Nordmann" />
          </div>

          <div class="section-divider"><span>Estimate &amp; tracking</span></div>
          <div class="field-row">
            <div class="field">
              <label for="tkPriority">Priority</label>
              <select id="tkPriority" name="priority">
                <option>Medium</option><option>Hotfix</option><option>High</option><option>Low</option>
              </select>
            </div>
            <div class="field">
              <label for="tkSize">Size <span class="opt">(optional t-shirt, never hours)</span></label>
              <select id="tkSize" name="size">
                <option value="">—</option><option>S</option><option>M</option><option>L</option><option>Ongoing</option>
              </select>
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="tkTarget">Target date <span class="opt">(optional)</span></label>
              <input type="date" id="tkTarget" name="targetDate" />
            </div>
            <div class="field">
              <label for="tkJira">Jira key <span class="opt">(optional, not unique)</span></label>
              <input type="text" id="tkJira" name="jiraKey" placeholder="e.g. FCK-3172" />
            </div>
          </div>
          <div class="field">
            <label for="tkDiscipline"><input type="checkbox" id="tkDiscipline" name="discipline" style="width:auto;margin-right:6px;vertical-align:-1px" /> Design discipline</label>
          </div>
        </div>
        <div class="modal-foot">
          <div class="modal-foot-spacer"></div>
          <button class="btn btn-ghost" type="button" data-close-dialog>Cancel</button>
          <button class="btn btn-primary" type="submit">Create Task</button>
        </div>
      </form>
    </dialog>

    <script>
      // Native <dialog> — showModal()/close() are the platform's own overlay +
      // focus trap + ESC-to-close.
      document.querySelectorAll<HTMLButtonElement>('[data-open-dialog]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.openDialog;
          const dialog = id && document.getElementById(id);
          if (dialog instanceof HTMLDialogElement) dialog.showModal();
        });
      });
      document.querySelectorAll<HTMLButtonElement>('[data-close-dialog]').forEach((btn) => {
        btn.addEventListener('click', () => {
          btn.closest('dialog')?.close();
        });
      });
      // Click on the backdrop (the dialog element itself, outside its content box) closes it.
      document.querySelectorAll<HTMLDialogElement>('dialog.modal').forEach((dialog) => {
        dialog.addEventListener('click', (e) => {
          if (e.target === dialog) dialog.close();
        });
      });
      // A form with data-confirm asks before submitting — used by destructive
      // one-click actions (e.g. "Remove" on an Epic card).
      document.querySelectorAll<HTMLFormElement>('form[data-confirm]').forEach((form) => {
        form.addEventListener('submit', (e) => {
          if (!window.confirm(form.dataset.confirm)) e.preventDefault();
        });
      });

      // Jira people picker (components/JiraPeoplePicker.astro) — search-as-
      // you-type against /api/jira/users, chips for what's picked so far,
      // kept as JSON in a hidden input the server resolves on submit
      // (resolveOrCreateFromJiraUser). Each .jira-people-picker is fully
      // independent, so the New Epic dialog and the Epic edit page's copy
      // never interfere with each other.
      interface JiraPersonPick {
        accountId: string;
        displayName: string;
        email: string | null;
      }
      document.querySelectorAll<HTMLElement>('.jira-people-picker').forEach((picker) => {
        const search = picker.querySelector<HTMLInputElement>('.jira-people-search')!;
        const results = picker.querySelector<HTMLElement>('.jira-people-results')!;
        const chips = picker.querySelector<HTMLElement>('.jira-people-chips')!;
        const hidden = picker.querySelector<HTMLInputElement>('.jira-people-value')!;
        let picks: JiraPersonPick[] = [];
        let debounceTimer: ReturnType<typeof setTimeout>;

        function renderChips() {
          hidden.value = JSON.stringify(picks);
          chips.innerHTML = '';
          picks.forEach((p, i) => {
            const chip = document.createElement('span');
            chip.className = 'person-tag';
            chip.textContent = p.displayName + ' ';
            const remove = document.createElement('button');
            remove.type = 'button';
            remove.textContent = '✕';
            remove.setAttribute('aria-label', `Remove ${p.displayName}`);
            remove.addEventListener('click', () => {
              picks.splice(i, 1);
              renderChips();
            });
            chip.appendChild(remove);
            chips.appendChild(chip);
          });
        }

        function closeResults() {
          results.hidden = true;
          results.innerHTML = '';
        }

        search.addEventListener('input', () => {
          clearTimeout(debounceTimer);
          const q = search.value.trim();
          if (q.length < 2) {
            closeResults();
            return;
          }
          debounceTimer = setTimeout(async () => {
            const res = await fetch(`/api/jira/users?q=${encodeURIComponent(q)}`);
            if (!res.ok) {
              closeResults();
              return;
            }
            const users: { accountId: string; displayName: string; emailAddress: string | null }[] = await res.json();
            results.innerHTML = '';
            const fresh = users.filter((u) => !picks.some((p) => p.accountId === u.accountId));
            if (fresh.length === 0) {
              closeResults();
              return;
            }
            fresh.forEach((u) => {
              const item = document.createElement('button');
              item.type = 'button';
              item.className = 'jira-people-result';
              item.textContent = u.emailAddress ? `${u.displayName} (${u.emailAddress})` : u.displayName;
              item.addEventListener('click', () => {
                picks.push({ accountId: u.accountId, displayName: u.displayName, email: u.emailAddress });
                renderChips();
                search.value = '';
                closeResults();
                search.focus();
              });
              results.appendChild(item);
            });
            results.hidden = false;
          }, 250);
        });

        // A blur would close the results before a click on one registers —
        // defer just long enough for that click to land first.
        search.addEventListener('blur', () => setTimeout(closeResults, 150));
      });

      // Jira issue picker (components/JiraIssuePicker.astro) — search-as-
      // you-type against /api/jira/issues; picking a result fills the
      // hidden jiraKey field and submits the form like any other in the
      // app (src/pages/api/roadmap-items/from-jira.ts does the rest).
      document.querySelectorAll<HTMLFormElement>('.jira-issue-picker').forEach((form) => {
        const search = form.querySelector<HTMLInputElement>('.jira-issue-search')!;
        const results = form.querySelector<HTMLElement>('.jira-people-results')!;
        const keyField = form.querySelector<HTMLInputElement>('input[name="jiraKey"]')!;
        let debounceTimer: ReturnType<typeof setTimeout>;

        function closeResults() {
          results.hidden = true;
          results.innerHTML = '';
        }

        search.addEventListener('input', () => {
          clearTimeout(debounceTimer);
          const q = search.value.trim();
          if (q.length < 2) {
            closeResults();
            return;
          }
          debounceTimer = setTimeout(async () => {
            const res = await fetch(`/api/jira/issues?q=${encodeURIComponent(q)}`);
            if (!res.ok) {
              closeResults();
              return;
            }
            const issues: { key: string; summary: string }[] = await res.json();
            results.innerHTML = '';
            if (issues.length === 0) {
              closeResults();
              return;
            }
            issues.forEach((issue) => {
              const item = document.createElement('button');
              item.type = 'button';
              item.className = 'jira-people-result';
              item.textContent = `${issue.key} — ${issue.summary}`;
              item.addEventListener('click', () => {
                keyField.value = issue.key;
                form.requestSubmit();
              });
              results.appendChild(item);
            });
            results.hidden = false;
          }, 250);
        });

        search.addEventListener('blur', () => setTimeout(closeResults, 150));
      });

      // All items board — drag a card between columns (src/pages/index.astro).
      // Persists via POST /api/roadmap-items/:id/move-column, then reloads so
      // the dropped card's real, server-confirmed bucket is what's shown.
      document.querySelectorAll<HTMLElement>('.board-card[draggable]').forEach((card) => {
        card.addEventListener('dragstart', (e) => {
          (e as DragEvent).dataTransfer?.setData('text/plain', card.dataset.id ?? '');
          card.classList.add('dragging');
        });
        card.addEventListener('dragend', () => card.classList.remove('dragging'));
      });
      document.querySelectorAll<HTMLElement>('.board-col-body[data-col]').forEach((colBody) => {
        colBody.addEventListener('dragover', (e) => {
          e.preventDefault();
          colBody.classList.add('drag-over');
        });
        colBody.addEventListener('dragleave', () => colBody.classList.remove('drag-over'));
        colBody.addEventListener('drop', async (e) => {
          e.preventDefault();
          colBody.classList.remove('drag-over');
          const cardId = (e as DragEvent).dataTransfer?.getData('text/plain');
          const column = colBody.dataset.col;
          if (!cardId || !column) return;

          await fetch(`/api/roadmap-items/${cardId}/move-column`, {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({ column }),
          });
          location.reload();
        });
      });
    </script>
  </body>
</html>
