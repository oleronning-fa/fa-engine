---
import RoadmapLayout from '../layouts/RoadmapLayout.astro';
import type { RoadmapItemType } from '../core/codesets';
import { getAssigneesByItemIds, getBoardItems, type ItemRow } from '../modules/roadmap/view/queries';
import { avatarColor, fmtDateShort, initials, jiraUrl, priorityChipClass, taskStatusChip, typeIcon } from '../modules/roadmap/view/render';

const items = await getBoardItems();
const assigneesByItem = await getAssigneesByItemIds(items.map((i) => i.id));

const DONE_LIMIT = 40;

function inCol(it: ItemRow, col: string): boolean {
  if (col === 'done') return it.status === 'Delivered';
  if (it.status !== 'In Jira') return false;
  if (col === 'neste') return it.backlogged === false && (!it.jiraSubstatus || it.jiraSubstatus === 'Todo' || it.jiraSubstatus === 'Waiting');
  if (col === 'pabegynt') return it.jiraSubstatus === 'In progress';
  if (col === 'review') return it.jiraSubstatus === 'CR' || it.jiraSubstatus === 'FT' || it.jiraSubstatus === 'On QA';
  return false;
}

const COLUMNS = [
  { key: 'neste', label: 'Neste' },
  { key: 'pabegynt', label: 'Påbegynt' },
  { key: 'review', label: 'Code review & testing' },
  { key: 'done', label: 'Done' },
] as const;

const buckets = COLUMNS.map((c) => ({
  ...c,
  all: items.filter((it) => inCol(it, c.key)),
}));
---
<RoadmapLayout title="All items" active="list">
  <div class="board-scroll">
    <div class="board">
      {buckets.map((col) => {
        const visible = col.key === 'done' ? col.all.slice(0, DONE_LIMIT) : col.all;
        const hidden = col.all.length - visible.length;
        return (
          <div class="board-col" data-col={col.key}>
            <div class="board-col-head">
              <span>{col.label}</span>
              <span class="count">{col.all.length}</span>
            </div>
            <div class="board-col-body">
              {visible.length === 0 && <div class="board-col-empty">Nothing here</div>}
              {visible.map((it) => {
                const icon = typeIcon(it.type as RoadmapItemType);
                const prClass = priorityChipClass(it.priority);
                const assignees = assigneesByItem.get(it.id) ?? [];
                const target = fmtDateShort(it.targetDate) ?? it.targetWeek;
                return (
                  <div class="board-card">
                    <div class="board-card-top">
                      <span class:list={['type-icon', icon.class]}>{icon.letter}</span>
                      {it.jiraKey ? (
                        <a class="jira-badge" href={jiraUrl(it.jiraKey)} target="_blank" rel="noopener noreferrer">{it.jiraKey}</a>
                      ) : (
                        <span class="muted" style="font-size:11px">no key</span>
                      )}
                    </div>
                    <div class="board-card-title">{it.title}</div>
                    {target && <div class="card-updated" style="margin-top:0">🗓 {target}</div>}
                    <div class="board-card-foot">
                      {prClass ? <span class:list={['chip', prClass]}>{it.priority}</span> : <span />}
                      <div class="assignees">
                        {assignees.length === 0 && <span class="muted">—</span>}
                        {assignees.map((name) => (
                          <span class="dot" style={`background:${avatarColor(name)}`} title={name}>{initials(name)}</span>
                        ))}
                      </div>
                    </div>
                  </div>
                );
              })}
              {hidden > 0 && <div class="board-col-empty">+{hidden} more — full list coming soon</div>}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</RoadmapLayout>
