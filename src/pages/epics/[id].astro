---
import RoadmapLayout from '../../layouts/RoadmapLayout.astro';
import JiraPeoplePicker from '../../components/JiraPeoplePicker.astro';
import {
  getAllUsers,
  getAssigneeIdsForItem,
  getAttachmentsForItem,
  getCommentsForItem,
  getItemById,
} from '../../modules/roadmap/view/queries';
import { AREAS, EPIC_LABEL_COLORS, EPIC_STATUSES } from '../../core/codesets';
import { fmtDateShort } from '../../modules/roadmap/view/render';

const { id } = Astro.params;
if (!id) return Astro.redirect('/epics', 303);

const epic = await getItemById(id);
if (!epic || epic.type !== 'Epic') return Astro.redirect('/epics', 303);

const people = await getAllUsers();
const assigneeIds = new Set(await getAssigneeIdsForItem(id));
const comments = await getCommentsForItem(id);
const attachments = await getAttachmentsForItem(id);
const redirectTo = `/epics/${id}`;

function fmtSize(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}
function isImage(mimeType: string): boolean {
  return mimeType.startsWith('image/');
}
---
<RoadmapLayout title={epic.title} active="epics">
  <a href="/epics" class="area-tag" style="display:inline-block;margin-bottom:14px">&larr; Back to Epics</a>

  <form method="POST" action={`/api/roadmap-items/${epic.id}`} style="max-width:640px;display:flex;flex-direction:column;gap:16px">
    <div class="field">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" value={epic.title} required />
    </div>

    <div class="field">
      <label for="description">Description</label>
      <textarea id="description" name="description">{epic.description ?? ''}</textarea>
    </div>

    <div class="section-divider"><span>Placement</span></div>
    <div class="field">
      <label for="area">Area <span class="opt">(optional — an epic can span several)</span></label>
      <select id="area" name="area">
        <option value="">Flere områder</option>
        {AREAS.map((a) => <option value={a.id} selected={a.id === epic.area}>{a.label}</option>)}
      </select>
    </div>

    <div class="section-divider"><span>Ownership &amp; status</span></div>
    <div class="field-row">
      <div class="field">
        <label for="ownerName">Owner <span class="opt">(type a name)</span></label>
        <input type="text" id="ownerName" name="ownerName" value={epic.ownerName ?? ''} placeholder="e.g. Ole Christian" />
      </div>
      <div class="field">
        <label for="coordinatorId">Coordinator <span class="opt">(Profico)</span></label>
        <select id="coordinatorId" name="coordinatorId">
          <option value="">Not set</option>
          {people.map((p) => <option value={p.id} selected={p.id === epic.coordinatorId}>{p.name}</option>)}
        </select>
      </div>
    </div>
    <div class="field">
      <label for="status">Status</label>
      <select id="status" name="status">
        {EPIC_STATUSES.map((s) => <option selected={s === epic.status}>{s}</option>)}
      </select>
    </div>
    <div class="field">
      <label>Importance label <span class="opt">(optional)</span></label>
      <div class="color-picker">
        <label class="color-swatch-none" title="No label">
          <input type="radio" name="colorLabel" value="" checked={!epic.colorLabel} />
          <span aria-hidden="true">✕</span>
        </label>
        {EPIC_LABEL_COLORS.map((c) => (
          <label class="color-swatch" style={`--swatch-color:${c.hex}`} title={c.id}>
            <input type="radio" name="colorLabel" value={c.id} checked={epic.colorLabel === c.id} />
          </label>
        ))}
      </div>
    </div>
    <div class="field">
      <label for="assigneeIds">Team</label>
      <select id="assigneeIds" name="assigneeIds" multiple>
        {people.map((p) => <option value={p.id} selected={assigneeIds.has(p.id)}>{p.name}</option>)}
      </select>
    </div>
    <JiraPeoplePicker id="editJira" />

    <div class="section-divider"><span>Tracking</span></div>
    <div class="field-row">
      <div class="field">
        <label for="targetDate">Estimated delivery <span class="opt">(optional)</span></label>
        <input type="date" id="targetDate" name="targetDate" value={epic.targetDate ?? ''} />
      </div>
      <div class="field">
        <label for="jiraKey">Jira key <span class="opt">(rare on an epic, optional)</span></label>
        <input type="text" id="jiraKey" name="jiraKey" value={epic.jiraKey ?? ''} placeholder="e.g. FCK-3172" />
      </div>
    </div>

    <div style="display:flex;gap:8px;justify-content:flex-end;padding-top:8px;border-top:1px solid var(--border)">
      <a href="/epics" class="btn btn-ghost">Cancel</a>
      <button class="btn btn-primary" type="submit">Save</button>
    </div>
  </form>

  <div class="section-divider" style="max-width:640px;margin-top:28px"><span>Attachments</span></div>
  <div style="max-width:640px">
    <form method="POST" action={`/api/roadmap-items/${epic.id}/attachments`} enctype="multipart/form-data" style="display:flex;gap:8px;align-items:center;margin:12px 0 16px">
      <input type="file" name="file" required />
      <button class="btn btn-primary btn-sm" type="submit">Upload</button>
    </form>

    {attachments.length === 0 && <p class="muted" style="font-size:12.5px">No files yet — documents and images both work.</p>}
    <div class="attachment-list">
      {attachments.map((a) => (
        <div class="attachment-item">
          {isImage(a.mimeType) ? (
            <a href={`/api/attachments/${a.id}`} target="_blank" rel="noopener noreferrer" class="attachment-thumb">
              <img src={`/api/attachments/${a.id}`} alt={a.filename} />
            </a>
          ) : (
            <a href={`/api/attachments/${a.id}`} target="_blank" rel="noopener noreferrer" class="attachment-thumb attachment-file">📄</a>
          )}
          <div class="attachment-meta">
            <a href={`/api/attachments/${a.id}`} target="_blank" rel="noopener noreferrer">{a.filename}</a>
            <span class="muted">{fmtSize(a.sizeBytes)} · {fmtDateShort(a.createdAt)}</span>
          </div>
          <form method="POST" action={`/api/attachments/${a.id}/delete`} data-confirm={`Remove "${a.filename}"? This can't be undone.`}>
            <input type="hidden" name="redirectTo" value={redirectTo} />
            <button class="card-quick-status card-quick-remove btn-sm" type="submit">🗑</button>
          </form>
        </div>
      ))}
    </div>
  </div>

  <div class="section-divider" style="max-width:640px;margin-top:28px"><span>Comments</span></div>
  <div style="max-width:640px">
    <form method="POST" action={`/api/roadmap-items/${epic.id}/comments`} style="display:flex;flex-direction:column;gap:8px;margin:12px 0 16px">
      <div class="field-row">
        <div class="field">
          <label for="authorId">Posting as</label>
          <select id="authorId" name="authorId" required>
            <option value="">Choose who you are…</option>
            {people.map((p) => <option value={p.id}>{p.name}</option>)}
          </select>
        </div>
      </div>
      <div class="field">
        <textarea name="body" placeholder="A short progress note…" required></textarea>
      </div>
      <div style="display:flex;justify-content:flex-end">
        <button class="btn btn-primary btn-sm" type="submit">Add comment</button>
      </div>
    </form>

    {comments.length === 0 && <p class="muted" style="font-size:12.5px">No comments yet.</p>}
    {comments.map((c) => (
      <div class="comment-item">
        <div class="who-when">
          <b>{c.authorName}</b>
          <span>{fmtDateShort(c.createdAt)}</span>
        </div>
        <div class="comment-text">{c.body}</div>
      </div>
    ))}
  </div>
</RoadmapLayout>
