# Copy to .env for local development:  cp .env.example .env
#
# Defaults for everything below live in the env schema in astro.config.mjs, not
# here — this file is what you may want to CHANGE locally, not a second copy of
# the defaults. A value the schema rejects fails the build (and errors loudly at
# runtime) with the variable named, rather than quietly falling back.

# ============================================================
# Login
# ============================================================
# Which login this app sits behind:
#   jb    = JournalistBoost, for apps on *.apps.journalistboost.ai (default)
#   zephr = Zephr / paywall at the CDN edge, for apps on finansavisen.no
# Set this to match where the app will actually live. Getting it wrong locks
# out exactly the people the app is for.
AUTH_MODE=jb

# Skip the login check. You have no JB cookie on localhost, so you need this
# to see your own app while developing.
# Only 'true' or 'false' — 'AUTH_DISABLED=1' is a hard error, deliberately.
# MUST be false (or absent) in production, or the app is readable by anyone.
AUTH_DISABLED=true

# ============================================================
# Local Zephr simulation
# ============================================================
# Fetches the real Finansavisen Zephr components and splices them into
# <!-- ZEPHR_FEATURE … --> markers, so you can see the FA header locally.
# Leave false in production — the Zephr CDN does this at the edge.
SIMULATE_ZEPHR=true

# ============================================================
# Database — Postgres 16+ with the pgvector extension. Required.
# ============================================================
# Local: install Postgres natively (see skills/tools-init) and point at your
# own database. Production: the platform injects this in Coolify — never fill
# a real value in here.
DATABASE_URL=postgres://user@localhost:5432/fa_engine_dev

# ============================================================
# GitHub — for the "save" skill
# ============================================================
# Personal Access Token with repo:write on the target repo.
# Treat this like a password. Never paste it into chat or commit it.
GITHUB_PAT=
# Full HTTPS clone URL of the journalist's repo, e.g.:
# https://github.com/<org>/<repo>.git
GIT_REMOTE=

# ============================================================
# App-level vars (extend per project)
# ============================================================
# Add each new variable to the env schema in astro.config.mjs first, then
# import it from 'astro:env/server'. Values the client must see are the
# exception: name them PUBLIC_… and declare them as client/public.
PORT=3000
